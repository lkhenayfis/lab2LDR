{
    // Ported from CasosLDR HydroToy: inflow_distr = Normal(60, 20).
    // The source truncates it to [0, 120]; truncation is applied downstream by
    // the lab2ldr pipeline (default settings) and is NOT declared here.
    // Stage 1 is deterministic (initial_inflow = 60): its marginal is Normal(60, 0),
    // i.e. zero variance, so both the LDR engine (which uses the mean) and the SDDP
    // engine (which samples) see exactly 60 at stage 1 -- same problem for both.
    // Inflows are independent across stages 2 and 3.
    "marginal_models": [
        {
            "id": 1,
            "distributions": [
                {
                    "season": 1,
                    "kind": "Normal",
                    "parameters": [
                        60,
                        0
                    ]
                },
                {
                    "season": 2,
                    "kind": "Normal",
                    "parameters": [
                        60,
                        20
                    ]
                },
                {
                    "season": 3,
                    "kind": "Normal",
                    "parameters": [
                        60,
                        20
                    ]
                }
            ]
        }
    ],
    // single hydro: trivial 1x1 correlation
    "copulas": [
        {
            "season": 1,
            "kind": "GaussianCopula",
            "parameters": [
                [
                    1.0
                ]
            ]
        },
        {
            "season": 2,
            "kind": "GaussianCopula",
            "parameters": [
                [
                    1.0
                ]
            ]
        },
        {
            "season": 3,
            "kind": "GaussianCopula",
            "parameters": [
                [
                    1.0
                ]
            ]
        }
    ]
}
