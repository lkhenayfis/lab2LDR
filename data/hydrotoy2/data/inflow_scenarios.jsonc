{
    // Ported from CasosLDR HydroToy: inflow_distr = Normal(60, 20).
    // The source truncates it to [0, 120]; truncation is applied downstream by
    // the lab2ldr pipeline (default settings) and is NOT declared here.
    // Stage 1 is deterministic in the source (initial_inflow = 60); the lab2ldr
    // engine fixes stage 1 to the mean of its marginal, which equals 60 here.
    "marginal_models": [
        {
            "id": 1,
            "distributions": [
                {
                    "season": 1,
                    "kind": "Normal",
                    "parameters": [
                        60,
                        20
                    ]
                },
                {
                    "season": 2,
                    "kind": "Normal",
                    "parameters": [
                        60,
                        20
                    ]
                }
            ]
        }
    ],
    // single hydro: trivial 1x1 correlation
    "copulas": [
        {
            "season": 1,
            "kind": "GaussianCopula",
            "parameters": [
                [
                    1.0
                ]
            ]
        },
        {
            "season": 2,
            "kind": "GaussianCopula",
            "parameters": [
                [
                    1.0
                ]
            ]
        }
    ]
}
