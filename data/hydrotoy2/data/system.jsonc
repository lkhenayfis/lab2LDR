{
    "buses": {
        "file": "buses.csv",
        "default_values": {
            // demand is treated as a hard constraint in the CasosLDR HydroToy
            // model; a high deficit cost emulates that (matches the deficit
            // penalty used by the SDDP variant in the source repo)
            "deficit_cost": 8000.0
        }
    },
    "lines": {
        "file": "lines.csv",
        "default_values": {
            "exchange_penalty": 0.01
        }
    },
    "hydros": {
        "file": "hydros.csv",
        "default_values": {
            "downstream_id": 0,
            // hydro generation equals turbined flow in the source model
            "productivity": 1.0,
            // the source objective has no spillage cost
            "spillage_penalty": 0.0
        }
    },
    "thermals": {
        "file": "thermals.csv",
        "default_values": {}
    }
}
